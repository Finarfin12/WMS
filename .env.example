# ============================================
# WMS Gudang — Environment Variables Template
# Copy ke .env.local dan isi nilai sebenarnya
# ============================================
#
# ADR-15 (2026-05-31): Backend pakai Apps Script Web App.
# Tidak ada lagi Service Account / Cloud Console / Spreadsheet IDs di sini —
# semua diatur Apps Script side via Script Properties.
# ============================================

# --- Apps Script Backend ---
# URL Web App Apps Script setelah di-deploy
# Format: https://script.google.com/macros/s/{deployment_id}/exec
APPS_SCRIPT_WEB_APP_URL=

# Shared secret untuk verify request datang dari Vercel
# Generate: openssl rand -hex 32
# Apps Script side simpan secret yang sama di Script Properties: INTERNAL_TOKEN
APPS_SCRIPT_INTERNAL_TOKEN=

# --- Authentication (JWT di Vercel side) ---
# JWT secret untuk session cookie (generate: openssl rand -hex 32)
JWT_SECRET=

# OTP expiry dalam detik (default: 300 = 5 menit)
OTP_EXPIRY_SECONDS=300

# --- Vercel KV (Upstash Redis) — untuk cache, write queue, rate limit ---
# Auto-set oleh Vercel saat link KV / Upstash Redis dari marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Cron secret (untuk Vercel Cron auth header) ---
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Maintenance ---
MAINTENANCE_MODE=false
